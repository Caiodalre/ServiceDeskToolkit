root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{ps1,psm1}]
charset = utf-8-bom
end_of_line = crlf
indent_style = space
indent_size = 4

[bootstrap.ps1]
# Bootstrap stays without BOM for legacy Windows download compatibility.
charset = utf-8
end_of_line = crlf

[*.cmd]
end_of_line = crlf

[*.md]
trim_trailing_whitespace = false

[*.{yml,yaml,json}]
indent_style = space
indent_size = 2
